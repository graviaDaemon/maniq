if ("${COMMAND}" STREQUAL "build")
    execute_process(COMMAND ${MANIQ} ${COMMAND} ${SOURCE} ERROR_VARIABLE output RESULT_VARIABLE exit_code)
    get_filename_component(directory ${SOURCE} DIRECTORY)
    string(REPLACE "${directory}/" "" output "${output}")
    file(WRITE ${ACTUAL} "${output}")

    string(FIND "${output}" "Error[" error_at)
    if (error_at EQUAL -1)
        set(expected_exit 0)
    else ()
        set(expected_exit 1)
    endif ()
    if (NOT exit_code EQUAL expected_exit)
        message(FATAL_ERROR "maniq build ${SOURCE} exited with ${exit_code}, expected ${expected_exit}")
    endif ()
elseif ("${COMMAND}" STREQUAL "types")
    set(work ${ACTUAL}.dir)
    file(REMOVE_RECURSE ${work})
    file(MAKE_DIRECTORY ${work})
    execute_process(COMMAND ${MANIQ} build ${SOURCE} WORKING_DIRECTORY ${work} ERROR_QUIET RESULT_VARIABLE exit_code)
    if (exit_code)
        message(FATAL_ERROR "maniq build ${SOURCE} exited with ${exit_code}")
    endif ()
    file(COPY_FILE ${work}/out.types ${ACTUAL})
else ()
    execute_process(COMMAND ${MANIQ} ${COMMAND} ${SOURCE} OUTPUT_FILE ${ACTUAL} RESULT_VARIABLE exit_code)
    if (exit_code)
        message(FATAL_ERROR "maniq ${COMMAND} ${SOURCE} exited with ${exit_code}")
    endif ()
endif ()

execute_process(COMMAND ${CMAKE_COMMAND} -E compare_files --ignore-eol ${ACTUAL} ${GOLDEN} RESULT_VARIABLE different)
if (different)
    message(FATAL_ERROR "${COMMAND} output differs.\n  expected: ${GOLDEN}\n  actual:   ${ACTUAL}")
endif ()
