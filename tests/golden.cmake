function(expect_exit output exit_code what)
    string(FIND "${output}" "Error[" error_at)
    if (error_at EQUAL -1)
        set(expected_exit 0)
    else ()
        set(expected_exit 1)
    endif ()
    if (NOT exit_code EQUAL expected_exit)
        message(FATAL_ERROR "${what} exited with ${exit_code}, expected ${expected_exit}")
    endif ()
endfunction()

function(expect_no_crash exit_code what)
    if (NOT exit_code MATCHES "^[01]$")
        message(FATAL_ERROR "${what} crashed: ${exit_code}")
    endif ()
endfunction()

function(write_golden)
    file(READ ${actual} content)
    string(REPLACE "\r\n" "\n" content "${content}")
    file(WRITE ${GOLDEN} "${content}")
endfunction()

set(bless "$ENV{MANIQ_BLESS}")

if ("${STAGE}" STREQUAL "orphans")
    string(REPLACE "|" ";" orphans "${ORPHANS}")
    if (orphans AND bless)
        file(REMOVE ${orphans})
        message(STATUS "removed golden files without a sample: ${orphans}")
    elseif (orphans)
        string(REPLACE ";" "\n  " orphans "${orphans}")
        message(FATAL_ERROR "golden files without a sample:\n  ${orphans}")
    endif ()
    return()
endif ()

file(REMOVE_RECURSE ${WORK})
file(MAKE_DIRECTORY ${WORK})
get_filename_component(name ${SOURCE} NAME_WE)
get_filename_component(extension ${GOLDEN} EXT)
set(actual ${WORK}/actual${extension})
set(applies TRUE)

if ("${STAGE}" STREQUAL "lex")
    execute_process(COMMAND ${MANIQ} lex ${SOURCE} WORKING_DIRECTORY ${WORK} OUTPUT_FILE ${actual} RESULT_VARIABLE exit_code)
    if (exit_code)
        message(FATAL_ERROR "maniq lex ${SOURCE} exited with ${exit_code}")
    endif ()
elseif ("${STAGE}" STREQUAL "parse")
    execute_process(COMMAND ${MANIQ} parse ${SOURCE} WORKING_DIRECTORY ${WORK} OUTPUT_FILE ${actual} ERROR_QUIET RESULT_VARIABLE exit_code)
    expect_no_crash("${exit_code}" "maniq parse ${SOURCE}")
    if (exit_code)
        set(applies FALSE)
    endif ()
elseif ("${STAGE}" STREQUAL "err")
    execute_process(COMMAND ${MANIQ} build ${SOURCE} WORKING_DIRECTORY ${WORK} ERROR_VARIABLE output RESULT_VARIABLE exit_code)
    get_filename_component(directory ${SOURCE} DIRECTORY)
    string(REPLACE "${directory}/" "" output "${output}")
    file(WRITE ${actual} "${output}")
    expect_exit("${output}" "${exit_code}" "maniq build ${SOURCE}")
else ()
    execute_process(COMMAND ${MANIQ} build ${SOURCE} WORKING_DIRECTORY ${WORK} ERROR_QUIET RESULT_VARIABLE exit_code)
    expect_no_crash("${exit_code}" "maniq build ${SOURCE}")
    if (exit_code)
        set(applies FALSE)
    elseif ("${STAGE}" STREQUAL "run")
        set(exe ${WORK}/${name})
        if (CMAKE_HOST_WIN32)
            set(exe ${exe}.exe)
        endif ()
        execute_process(COMMAND ${exe} WORKING_DIRECTORY ${WORK} OUTPUT_VARIABLE output ERROR_VARIABLE output RESULT_VARIABLE exit_code)
        file(WRITE ${actual} "${output}")
        expect_exit("${output}" "${exit_code}" "${exe}")
    else ()
        file(COPY_FILE ${WORK}/out.${STAGE} ${actual})
    endif ()
endif ()

if (NOT applies)
    if (EXISTS ${GOLDEN} AND bless)
        file(REMOVE ${GOLDEN})
        message(STATUS "removed ${GOLDEN}")
    elseif (EXISTS ${GOLDEN})
        message(FATAL_ERROR "${GOLDEN} should not exist: maniq stops with an error before the ${STAGE} stage for this sample")
    endif ()
    return()
endif ()

if (NOT EXISTS ${GOLDEN})
    if (bless)
        write_golden()
        message(STATUS "created ${GOLDEN}")
        return()
    endif ()
    message(FATAL_ERROR "missing golden file ${GOLDEN}\n  create it with: cmake --workflow --preset bless")
endif ()

execute_process(COMMAND ${CMAKE_COMMAND} -E compare_files --ignore-eol ${actual} ${GOLDEN} RESULT_VARIABLE different)
if (NOT different)
    return()
endif ()
if (bless)
    write_golden()
    message(STATUS "updated ${GOLDEN}")
    return()
endif ()

find_program(GIT git)
if (GIT)
    execute_process(COMMAND ${GIT} -c core.autocrlf=false diff --no-index --ignore-cr-at-eol --color=never ${GOLDEN} ${actual} OUTPUT_VARIABLE diff)
    message("${diff}")
endif ()
message(FATAL_ERROR "${STAGE} output differs from ${GOLDEN}")
